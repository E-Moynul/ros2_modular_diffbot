<?xml version="1.0"?>
<robot name="my_diff_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- এই ফাইলে শুধু Gazebo-specific জিনিস থাকবে (plugin, sensor plugin ইত্যাদি)।
         Link/joint/material সব robot_core.xacro তে থাকবে।
         এভাবে আলাদা রাখলে ভবিষ্যতে physical robot (real hardware) এর জন্য
         আলাদা code লেখার সময় শুধু robot_core.xacro reuse করা যায়,
         এই ফাইলটা শুধু simulation এর জন্য দরকার হয়। -->

    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.17</wheel_separation>
            <wheel_diameter>0.06</wheel_diameter>
            <max_wheel_torque>200</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>

            <command_topic>cmd_vel</command_topic>

            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>

        </plugin>
    </gazebo>

</robot>
