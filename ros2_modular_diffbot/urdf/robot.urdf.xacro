<?xml version="1.0"?>
<robot name="my_diff_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- এই ফাইলটা কোনো shape/plugin নিজে define করে না।
         শুধু বাকি সব xacro ফাইলকে একসাথে জোড়া লাগায়।
         ভবিষ্যতে camera/lidar/sensor যোগ করলে এখানে আরেকটা
         xacro:include লাইন যোগ করলেই হবে। -->

    <xacro:include filename="robot_core.xacro" />
    <xacro:include filename="robot_gazebo.xacro" />

</robot>
